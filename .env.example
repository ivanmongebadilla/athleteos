# Required for authentication. Copy to .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key
# Phase 3 AI foundation. Optional until coaching is configured. Server-only values.
# Add the real API key to .env.local; never commit it or prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Explicit Responses-compatible model ID available to your API project; no automatic fallback.
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=2048
